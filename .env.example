SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Recommended for the server-side cache route on Vercel.
# Keep this private. Do not expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional server-only fallback for words that CMUdict cannot pronounce.
PHONEMIZER_API_URL=
PHONEMIZER_API_KEY=

# Optional OpenAI-compatible embeddings endpoint. Otherwise use local MiniLM.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional OpenAI-compatible chat completions endpoint, for candidates only.
SEMANTIC_GENERATOR_API_URL=
SEMANTIC_GENERATOR_API_KEY=
SEMANTIC_GENERATOR_MODEL=
